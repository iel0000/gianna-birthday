# Copy this file to .env.local and fill in the values.
#
#   cp .env.example .env.local
#
# Vite reads env only at startup — restart `npm run dev` after editing.
# For production these become GitHub Actions secrets; see README.md.
# No quotes, no trailing spaces.


# ─── Supabase (required) ──────────────────────────────────────────
# Dashboard → Settings → API. The anon key is a public key by design —
# it ships in the client bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ─── EmailJS (optional) ───────────────────────────────────────────
# Leave blank to skip confirmation emails — RSVPs still save to Supabase.
# service id   → Email Services
# template ids → Email Templates (paste email-templates/*.html into them)
# public key   → Account → General
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_GUEST_TEMPLATE_ID=
VITE_EMAILJS_HOST_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Where the host notification lands. Defaults to ariel.magsino@hivve.tech.
VITE_HOST_EMAIL=


# ─── Site (optional) ──────────────────────────────────────────────
# Absolute URL used for the rsvp_link in emails. Falls back to the
# browser's origin. The deploy workflow sets this automatically.
VITE_SITE_URL=

# Vite base path, defaults to './'. The deploy workflow sets this from the
# path GitHub Pages assigns. Only set it locally to reproduce a subpath.
VITE_BASE_PATH=
